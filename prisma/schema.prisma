// Prisma schema for নেকির ঝুড়ি platform
// Models: UmmahNeed (urgent needs), Project + ProjectUpdate (developing stories),
//         FixedProject (running madrasa/maktab), Module (revenue modules -> funnel)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// উম্মাহর জরুরি প্রয়োজন — এককালীন (যেমন: মাদরাসার বেসিক চাহিদা, ছাত্রের পড়াশোনা)
model UmmahNeed {
  id            String   @id @default(cuid())
  title         String
  slug          String? @unique // URL slug (nullable until Phase 5 populates it)
  summary       String
  description   String
  category      String   @default("general") // madrasa | student | medical | family | emergency
  location      String?
  targetAmount  Int
  raisedAmount  Int      @default(0)
  image         String?
  urgency       String   @default("normal") // critical | high | normal
  beneficiary   String?
  status        String   @default("active") // active | funded | closed
  bKashNumber   String? // bKash number shown on the detail page
  bKashType     String   @default("personal") // personal | merchant
  donorCount    Int      @default(0) // incremented per confirmed donation (Phase 6)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// ডেভেলপিং স্টোরি — একটি প্রজেক্ট যা ধাপে ধাপে এগোচ্ছে (টাইমলাইন সহ)
/// Phase 7 treats this as a blog (published/draft, featured, tags, author).
model Project {
  id            String           @id @default(cuid())
  name          String
  slug          String           @unique
  description   String
  location      String?
  status        String           @default("ongoing") // ongoing | completed | planning
  targetAmount  Int
  raisedAmount  Int              @default(0)
  featuredImage String?
  tags          String? // comma-separated or JSON string
  published     Boolean           @default(true) // draft vs published (blog)
  featured      Boolean           @default(false) // highlight on blog index
  authorId      String? // AdminUser id (relation added below)
  author        AdminUser?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  startDate     DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  updates       ProjectUpdate[]
}

/// প্রজেক্টের টাইমলাইন এন্ট্রি — প্রতিটি আপডেট (ভিজিট, অগ্রগতি, চাহিদা)
/// Phase 7 adds rich-text `body` (markdown) + published/draft control.
model ProjectUpdate {
  id               String   @id @default(cuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date             DateTime @default(now())
  title            String
  description      String // short summary (list view)
  body             String? // full markdown body (detail view) — Phase 7
  image            String?
  collectedAmount  Int      @default(0)
  neededAmount     Int      @default(0)
  published        Boolean  @default(true) // draft vs published
  createdAt        DateTime @default(now())
}

/// স্থায়ী প্রজেক্ট — চলমান মাদরাসা / মক্তব / এতিমখানা
/// Phase 8 adds slug (detail page) + gallery (JSON array of image paths).
model FixedProject {
  id            String   @id @default(cuid())
  name          String
  slug          String? @unique // URL slug for detail page (Phase 8)
  type          String   @default("madrasha") // madrasha | moktob | orphanage | clinic | mosque
  description   String
  location      String?
  beneficiaries Int      @default(0)
  monthlyCost   Int      @default(0)
  establishedAt String?
  image         String?
  gallery       String? // JSON array of image paths (Phase 8)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// রেভিনিউ মডিউল — প্রতিটি মডিউল থেকে একটি শতাংশ নেকির ঝুড়ি ফানেলে যায়
/// Phase 4 adds slug, howItWorks, socialLinks, featuredImage, status for full
/// admin management + a public detail page per module.
model RevenueModule {
  id            String   @id @default(cuid())
  name          String
  slug          String? @unique // URL slug for detail page (Phase 4)
  description   String
  howItWorks   String? // markdown / rich text explaining the module (Phase 4)
  icon          String?
  featuredImage String? // cover image (Phase 4)
  socialLinks   String? // JSON array of {type, url} (Phase 4)
  funnelPercent Int      @default(0)
  order         Int      @default(0)
  status        String   @default("active") // active | inactive | archived
  isActive      Boolean  @default(true) // kept for backward-compat with public API
  createdAt     DateTime @default(now())
}

/// অ্যাডমিন ইউজার — অ্যাডমিন প্যানেলে লগইন করতে পারে এমন ব্যক্তি
/// role: super_admin (সবকিছু) | editor (শুধু কন্টেন্ট)
model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  role         String         @default("super_admin") // super_admin | editor
  isActive     Boolean        @default(true)
  lastLoginAt  DateTime?
  projects     Project[]      // stories authored by this admin (Phase 7)
  uploads      UploadedImage[] // images uploaded by this admin (Phase 2)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

/// আপলোড করা ছবি — মিডিয়া লাইব্রেরি ট্র্যাকিং (Phase 2)
/// প্রতিটি আপলোড sharp দিয়ে webp-এ অপটিমাইজ করা হয়।
/// deletedAt: soft-delete (null = active, set = trashed). File on disk
/// is deleted immediately; the row is kept for audit/history.
model UploadedImage {
  id           String    @id @default(cuid())
  filename     String // original filename (for display)
  path         String // public URL path, e.g. /uploads/2025/01/uuid.webp
  mimetype     String // original MIME type (e.g. image/png) — file on disk is webp
  size         Int // file size in bytes (after optimization)
  width        Int // image width in pixels
  height       Int // image height in pixels
  uploadedById String?
  uploadedBy   AdminUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  deletedAt    DateTime? // soft-delete marker; null = active
  createdAt    DateTime  @default(now())

  @@index([uploadedById])
  @@index([createdAt])
  @@index([deletedAt]) // fast filter for active (deletedAt IS NULL)
}
