# ============================================================
# নেকির ঝুড়ি — Environment Variables Example
# Copy this file to .env and fill in real values for your environment.
# NEVER commit the real .env file.
# ============================================================

# ---------- Core Application ----------
NEXT_PUBLIC_SITE_URL="https://nekirjhuri.com"
NODE_ENV="production"

# ---------- Database (MySQL — production) ----------
DATABASE_URL="mysql://nekirjhuri:STRONG_PASSWORD@localhost:3306/nekirjhuri"

# ---------- Admin Authentication (NextAuth.js) ----------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://nekirjhuri.com"

# Email of the bootstrap super_admin
ADMIN_BOOTSTRAP_EMAIL="admin@nekirjhuri.org"

# ---------- Upload Directory ----------
# Persistent directory for uploaded images. Must survive rebuilds.
UPLOAD_DIR="/var/www/nekirjhuri.com/uploads"

# ---------- AI Services (optional) ----------
# Only needed if regenerating images server-side.
# ZAI_API_KEY="your-zai-api-key"
