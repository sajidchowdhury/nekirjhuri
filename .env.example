# ============================================================
# নেকির ঝুড়ি — Environment Variables Example
# Copy this file to .env and fill in real values for your environment.
# NEVER commit the real .env file.
# ============================================================

# ---------- Core Application ----------
# Base URL of the deployed site (used for SEO, OpenGraph, sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Node environment (development | production)
NODE_ENV="development"

# ---------- Database ----------
# Development (SQLite) — default for local work
DATABASE_URL="file:./db/custom.db"

# Production (MySQL) — switch prisma/schema.prisma provider to "mysql" first
# DATABASE_URL="mysql://nekirjhuri:STRONG_PASSWORD@localhost:3306/nekirjhuri"

# ---------- Admin Authentication (NextAuth.js) ----------
# A strong random string used to sign JWTs. Generate one with:
#   openssl rand -base64 32
# or any 32+ char random string. NEVER reuse across environments.
NEXTAUTH_SECRET="change-me-to-a-strong-random-string-at-least-32-chars"

# The canonical URL of the deployed app (no trailing slash).
# Dev:  http://localhost:3000
# Prod: https://nekirjhuri.org
NEXTAUTH_URL="http://localhost:3000"

# Email of the bootstrap super_admin created by `bun run prisma/seed-admin.ts`.
# Set this to your own email before running the seed script.
ADMIN_BOOTSTRAP_EMAIL="admin@nekirjhuri.org"

# ---------- AI Services (optional) ----------
# Only needed if regenerating images server-side via z-ai-web-dev-sdk.
# The site ships with pre-generated images in /public/images, so this is optional.
# ZAI_API_KEY="your-zai-api-key"
